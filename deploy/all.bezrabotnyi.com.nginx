server {
    listen 80;
    listen [::]:80;
    server_name all.bezrabotnyi.com;

    return 301 https://$host$request_uri;
}

server {
    # The public 443 listener is HAProxy; it forwards TLS with SNI here.
    listen 127.0.0.1:8444 ssl http2;
    server_name all.bezrabotnyi.com;

    ssl_certificate /etc/letsencrypt/live/all.bezrabotnyi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/all.bezrabotnyi.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
